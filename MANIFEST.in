graft flaskit/templates
include flaskit/templates/project/env.j2
include flaskit/templates/project/dockerignore
include flaskit/templates/project/Dockerfile
include flaskit/templates/project/python-version
include flaskit/templates/project/templates/swagger_ui.html
recursive-include flaskit/templates *.j2 *.css *.js *.html Dockerfile dockerignore python-version
global-exclude __pycache__ *.py[cod] *.pyo .gitkeep
prune flaskit/templates/project/resources
