# API / Swagger
API_TITLE={{ project_name }}
API_DESCRIPTION={{ project_name }} API
API_VERSION=1.0.0
OPENAPI_VERSION=3.0.3
BASE_PATH=/
DOCS_PATH=/docs

# Server / runtime (development -> Flask; production -> bjoern)
ENV=development
DEBUG=true
HOST=127.0.0.1
PORT=5000
BJOERN_REUSE_PORT=true

# Auth
AUTH_SCHEME=bearer
AUTH_HEADER=Authorization
AUTH_BEARER_FORMAT=JWT
AUTH_SECURITY_NAME=httpAuth

# Logging (shared)
LOG_LEVEL=INFO
LOG_OUTPUT=stream,file
LOG_STREAM=stderr
LOG_FORMAT=%(message)s
LOG_DATE_FORMAT=%Y-%m-%d %H:%M:%S
LOG_ROTATION=size
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=5
LOG_WHEN=midnight
LOG_INTERVAL=1
LOG_PROPAGATE=false
LOG_REDACT_HEADERS=authorization,cookie,set-cookie,x-api-key

# Per-purpose loggers
LOG_APP_NAME=flask.app
LOG_APP_FILE=logs/app.log
LOG_REQUEST_NAME=werkzeug.request
LOG_REQUEST_FILE=logs/request.log
LOG_RESPONSE_NAME=werkzeug.response
LOG_RESPONSE_FILE=logs/response.log

# OpenTelemetry
OTEL_ENABLED=false
OTEL_SERVICE_NAME={{ project_name }}
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Static files under assets/statics/ (served at /assets/statics/..., browser cache)
STATIC_CACHE_MAX_AGE=604800

# Flask
SECRET_KEY=change-me
FLASK_APP=app:create_app
